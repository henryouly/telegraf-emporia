# Copy to .env and fill in real values. Never commit .env.
EMPORIA_EMAIL=
EMPORIA_PASSWORD=
COGNITO_REGION=us-east-2
COGNITO_CLIENT_ID=

# InfluxDB v2 (http://192.168.30.20:8086). INFLUX_ORG accepts org name or ID.
INFLUX_URL=http://192.168.30.20:8086
INFLUX_TOKEN=
INFLUX_ORG=
INFLUX_BUCKET=energy

# Go durations, e.g. 60s, 1m, 10m
POLL_INTERVAL=1m
FETCH_WINDOW=10m
