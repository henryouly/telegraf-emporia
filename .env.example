# Emporia (used by both the daemon and cmd/poll).
EMPORIA_EMAIL=
EMPORIA_PASSWORD=
COGNITO_REGION=us-east-2
COGNITO_CLIENT_ID=
# Optional: Cognito token cache location (default: $TMPDIR/emporia-token.json).
#EMPORIA_TOKEN_FILE=/var/lib/telegraf/emporia-token.json

# InfluxDB v2. Only needed by the legacy daemon (go run .) — the Telegraf
# exec path reads these in telegraf.conf / the service EnvironmentFile instead.
# INFLUX_ORG accepts org name or ID. Use localhost when running next to InfluxDB.
INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=
INFLUX_ORG=
INFLUX_BUCKET=energy

# Go durations, e.g. 60s, 1m, 10m
POLL_INTERVAL=1m
FETCH_WINDOW=10m
